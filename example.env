TODOIST_CATEGORIZER_TODOIST_API_TOKEN=
TODOIST_CATEGORIZER_OPENAI_API_KEY=

# comma separated, no spaces, no brackets
TODOIST_CATEGORIZER_PROJECT_IDS=abc123,def567

# Milliseconds between full polling cycles. Increase this interval when
# monitoring multiple projects to stay within Todoist API limits.
TODOIST_CATEGORIZER_POLL_INTERVAL_MS=2000

# optionally change the log level (default is INFO)
# TODOIST_CATEGORIZER_LOG_LEVEL=DEBUG

# optional
# TODOIST_CATEGORIZER_OPENAI_MODEL=