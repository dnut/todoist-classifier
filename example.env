TODOIST_CLASSIFIER_TODOIST_API_TOKEN=
TODOIST_CLASSIFIER_OPENAI_API_KEY=

# comma separated, no spaces, no brackets
TODOIST_CLASSIFIER_PROJECT_IDS=abc123,def567

# Milliseconds between full polling cycles. Increase this interval when
# monitoring multiple projects to stay within Todoist API limits.
TODOIST_CLASSIFIER_POLL_INTERVAL_MS=2000

# optionally change the log level (default is INFO)
# TODOIST_CLASSIFIER_LOG_LEVEL=DEBUG

# optional llm configuration
# TODOIST_CLASSIFIER_OPENAI_MODEL=
# TODOIST_CLASSIFIER_OPENAI_REASONING_EFFORT=
